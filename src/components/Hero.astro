---
import type { LocaleCode } from '../data/i18n/locales';
import { defaultLocale } from '../data/i18n/locales';
import { productInfo, siteConfig } from '../data/site';
import ShimmerButton from './inspira/ShimmerButton.astro';
import {
	heroHeight,
	heroSizes,
	heroSrc,
	heroSrcSet,
	heroWidth,
} from '../lib/responsive-images';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getT(locale);
const useBrandHero = true;
const monthly = productInfo.plans.find((p) => p.id === 'monthly') ?? productInfo.plans[0];

const title = useBrandHero ? siteConfig.name : t('hero.accent');
const subtitle = useBrandHero ? t('hero.subtitle') : t('hero.subtitleShort');
const ctaBuy = useBrandHero ? t('cta.buy') : t('hero.buyNow');
const priceFrom = t('hero.priceFrom');
const priceLabel = priceFrom ? `${priceFrom} $${monthly.price}` : `$${monthly.price}`;
const imageAlt = t('hero.imageAlt', { brand: siteConfig.name });

const chips = [
	{ key: 'chipEsp', icon: 'esp', edit: 'chipEsp' },
	{ key: 'chipAim', icon: 'aim', edit: 'chipAim' },
	{ key: 'chipRadar', icon: 'radar', edit: 'chipRadar' },
	{ key: 'chipUpdates', icon: 'updates', edit: 'chipUpdates' },
] as const;
---

<section class="hero" aria-label={title}>
	<div class="hero__media">
		<img
			src={heroSrc}
			srcset={heroSrcSet}
			sizes={heroSizes}
			alt={imageAlt}
			width={heroWidth}
			height={heroHeight}
			fetchpriority="high"
			loading="eager"
			decoding="async"
		/>
	</div>
	<div class="hero__veil" aria-hidden="true"></div>
	<div class="shell hero__content">
		<div class="hero__copy">
			<h1 class="hero__brand">
				{useBrandHero ? <span data-edit="name">{title}</span> : title}
			</h1>
			<p class="hero__lede" data-edit={useBrandHero ? 'heroLede' : undefined}>
				{subtitle}
			</p>
			<div class="hero__actions">
				<ShimmerButton
					class="hero__buy"
					href={siteConfig.checkoutUrl}
					rel="noopener noreferrer"
					shimmerColor="#28d5df"
					background="#18b8c8"
					aria-label={`${ctaBuy} — ${priceLabel}`}
				>
					<svg class="hero__buy-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
						<path
							d="M4.5 6.5h2.1l1.2 9.2h9.4l1.8-6.6H8.1M9.2 19.2a.9.9 0 100-1.8.9.9 0 000 1.8zm7.4 0a.9.9 0 100-1.8.9.9 0 000 1.8z"
							stroke="currentColor"
							stroke-width="1.7"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
					<span class="hero__buy-label" data-edit={useBrandHero ? 'ctaBuy' : undefined}>{ctaBuy}</span>
					<span class="hero__buy-price">{priceLabel}</span>
				</ShimmerButton>
			</div>
			<ul class="hero__features">
				{
					chips.map((chip) => (
						<li>
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
								{chip.icon === 'esp' && (
									<>
										<circle cx="12" cy="12" r="7.5" stroke="currentColor" stroke-width="1.6" />
										<path
											d="M12 8.5v3.2L14.2 14"
											stroke="currentColor"
											stroke-width="1.6"
											stroke-linecap="round"
										/>
									</>
								)}
								{chip.icon === 'aim' && (
									<path
										d="M12 4.5l1.7 4.8H19l-4 3.1 1.5 4.8L12 14.8 7.5 17.2 9 12.4 5 9.3h5.3L12 4.5z"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linejoin="round"
									/>
								)}
								{chip.icon === 'radar' && (
									<>
										<circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6" />
										<circle cx="12" cy="12" r="7.5" stroke="currentColor" stroke-width="1.6" />
										<path
											d="M12 2.8v2.2M12 19v2.2M2.8 12h2.2M19 12h2.2"
											stroke="currentColor"
											stroke-width="1.6"
											stroke-linecap="round"
										/>
									</>
								)}
								{chip.icon === 'updates' && (
									<path
										d="M5 13.2l4.2 4.2L19 7.6"
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								)}
							</svg>
							<span data-edit={useBrandHero ? chip.edit : undefined}>{t(`hero.${chip.key}`)}</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style is:global>
	.hero {
		--hero-pad-y: clamp(1rem, 2vw, 1.75rem);
		--hero-stack: clamp(0.5rem, 1.1vw, 0.75rem);
		/*
		 * Bar is a bit shorter than the native 1024/409 (~2.5:1) art.
		 * Image stays undistorted via object-fit: cover (crops edges, no squash).
		 */
		--hero-ratio: 3.15 / 1;
		position: relative;
		isolation: isolate;
		display: grid;
		align-items: center;
		overflow: hidden;
		background: var(--bg);
		aspect-ratio: var(--hero-ratio);
		width: 100%;
		height: auto;
		min-height: 0;
		max-height: none;
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero__media picture,
	.hero__media img {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero__media img {
		/* Cover = keep proportions; crop top/bottom of the shorter bar */
		object-fit: cover;
		object-position: center 45%;
		image-rendering: auto;
		transform: translateZ(0);
		filter: brightness(0.72) saturate(0.92);
		animation: hero-in 0.9s ease-out both;
	}

	.hero__media::after {
		content: '';
		position: absolute;
		inset: 0;
		background: rgba(7, 13, 20, 0.22);
		pointer-events: none;
	}

	.hero__veil {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background: linear-gradient(
			90deg,
			rgba(7, 13, 20, 0.65) 0%,
			rgba(7, 13, 20, 0.52) 34%,
			rgba(7, 13, 20, 0.28) 58%,
			rgba(7, 13, 20, 0.08) 78%
		);
	}

	.hero__content {
		position: relative;
		z-index: 2;
		pointer-events: none;
		padding-block: var(--hero-pad-y);
		align-self: center;
		/* Sit a touch above true center so title reads mid-image */
		transform: translateY(clamp(-1.5rem, -3vw, -0.35rem));
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		justify-items: start;
		box-sizing: border-box;
	}

	.hero__copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--hero-stack);
		width: min(100%, 26rem);
		max-width: 100%;
		min-width: 0;
		margin: 0;
		padding: 0;
		animation: rise 0.65s ease-out both;
	}

	.hero__brand {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.35rem, 4.8vw, 3.5rem);
		font-weight: 700;
		line-height: 1.06;
		letter-spacing: -0.035em;
		overflow-wrap: anywhere;
		color: #fff;
		width: 100%;
		text-wrap: balance;
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.85);
	}

	.hero__lede {
		margin: 0;
		width: 100%;
		max-width: 34ch;
		font-size: clamp(0.95rem, 1.45vw, 1.0625rem);
		line-height: 1.55;
		color: var(--ink-muted);
		text-wrap: pretty;
		text-shadow: 0 1px 8px rgba(0, 0, 0, 0.8);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.7rem;
		margin: 0;
		width: 100%;
	}

	.hero__buy {
		pointer-events: auto;
		gap: 0.55rem;
		width: auto;
		max-width: 100%;
		min-height: 3rem;
		padding: 0.55rem 0.55rem 0.55rem 1.05rem;
		font-size: 0.9375rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		color: #070d14;
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.32);
	}

	.hero__buy-icon {
		width: 1.05rem;
		height: 1.05rem;
		flex-shrink: 0;
		opacity: 0.9;
	}

	.hero__buy-label {
		padding-right: 0.15rem;
		white-space: nowrap;
	}

	.hero__buy-price {
		display: inline-flex;
		align-items: center;
		min-height: 2rem;
		margin-left: 0.35rem;
		padding: 0 0.85rem;
		border-radius: 999px;
		background: rgba(7, 13, 20, 0.88);
		color: #fff;
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	.hero__buy:hover .hero__buy-price {
		background: #070d14;
		color: #fff;
	}

	.hero__features {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 1rem;
		row-gap: 0.55rem;
		margin: 0;
		padding: 0;
		list-style: none;
		width: 100%;
		max-width: none;
	}

	.hero__features li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1.3;
		color: var(--ink-muted);
		text-shadow: 0 1px 6px rgba(0, 0, 0, 0.75);
	}

	.hero__features li span {
		min-width: 0;
	}

	.hero__features svg {
		width: 1rem;
		height: 1rem;
		flex-shrink: 0;
		color: var(--magenta-soft);
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes hero-in {
		from {
			opacity: 0.7;
		}
		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__copy,
		.hero__media img {
			animation: none;
		}

		.hero__buy,
		.hero__buy:hover {
			transition: none;
			transform: none;
		}

		.hero__content {
			transform: translateY(clamp(-1.5rem, -3vw, -0.35rem));
		}
	}

	@media (max-width: 900px) {
		.hero {
			aspect-ratio: auto;
			min-height: 0;
			max-height: none;
			height: auto;
			display: block;
			overflow: hidden;
		}

		.hero__media img {
			object-fit: cover;
			object-position: 78% 10%;
		}

		.hero__veil {
			background: linear-gradient(
				180deg,
				rgba(7, 13, 20, 0.35) 0%,
				rgba(7, 13, 20, 0.55) 42%,
				rgba(7, 13, 20, 0.82) 78%,
				rgba(7, 13, 20, 0.92) 100%
			);
		}

		.hero__content {
			transform: none;
			width: 100%;
			min-height: clamp(18.5rem, 56svh, 28rem);
			display: flex;
			align-items: flex-end;
			padding-block: 1.35rem 1.2rem;
			padding-bottom: max(1.2rem, env(safe-area-inset-bottom, 0px));
			box-sizing: border-box;
		}

		.hero__copy {
			width: 100%;
			max-width: 28rem;
			gap: 0.65rem;
		}

		.hero__brand {
			font-size: clamp(1.7rem, 7.5vw, 2.35rem);
			line-height: 1.08;
		}

		.hero__lede {
			display: block;
			overflow: visible;
			-webkit-line-clamp: unset;
			font-size: clamp(0.9rem, 3.6vw, 1rem);
			max-width: 34ch;
			color: color-mix(in srgb, #fff 80%, var(--ink-muted));
		}

		.hero__actions {
			width: 100%;
		}

		.hero__buy {
			width: 100%;
			max-width: 22rem;
			min-height: var(--touch-min, 2.75rem);
			font-size: 0.9375rem;
			justify-content: flex-start;
		}

		.hero__buy-price {
			margin-left: auto;
		}

		.hero__features {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: 0.75rem;
			row-gap: 0.45rem;
			max-width: 22rem;
		}

		.hero__features li {
			font-size: 0.78rem;
		}
	}

	@media (max-width: 480px) {
		.hero__content {
			min-height: clamp(17.5rem, 60svh, 26rem);
			padding-block: 1.2rem 1.1rem;
		}

		.hero__brand {
			font-size: clamp(1.55rem, 8.2vw, 1.95rem);
		}

		.hero__lede {
			max-width: none;
		}

		.hero__buy {
			width: 100%;
			max-width: none;
		}

		.hero__features {
			max-width: none;
		}
	}

	@media (max-width: 360px) {
		.hero__content {
			min-height: clamp(16.5rem, 64svh, 24rem);
		}

		.hero__brand {
			font-size: 1.45rem;
		}

		.hero__features {
			grid-template-columns: 1fr;
			row-gap: 0.35rem;
		}
	}

	@media (max-width: 900px) and (orientation: landscape) and (max-height: 480px) {
		.hero__content {
			min-height: min(70svh, 16.5rem);
			padding-block: 0.85rem 0.8rem;
		}

		.hero__lede {
			display: -webkit-box;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 2;
			overflow: hidden;
			font-size: 0.85rem;
		}

		.hero__features {
			display: none;
		}

		.hero__buy {
			max-width: 20rem;
		}
	}
</style>
