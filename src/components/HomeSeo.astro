---
import HomeSeoApp from './react/HomeSeo';
import { homeFaqs, siteConfig } from '../data/site';
import { getFaqPath } from '../data/faq';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getNavPaths } from '../data/i18n/localized-nav-paths';

interface Props {
	locale?: LocaleCode;
	navPaths?: ReturnType<typeof getNavPaths>;
	embedded?: boolean;
}

const locale = Astro.props.locale ?? defaultLocale;
const navPaths = Astro.props.navPaths ?? getNavPaths(locale);
const embedded = Astro.props.embedded ?? false;
const faqs = homeFaqs.map((item) => ({
	slug: item.slug,
	question: item.question,
	answer: item.answer,
	href: getFaqPath(item.slug),
}));
---

<HomeSeoApp
	client:visible
	locale={locale}
	checkoutUrl={siteConfig.checkoutUrl}
	faqs={faqs}
	navPaths={navPaths}
	embedded={embedded}
/>

<style is:global>
	.home-seo {
		padding-block: clamp(2.75rem, 5vw, 4rem);
		color: var(--ink-muted);
		font-size: 0.9375rem;
		line-height: 1.55;
	}

	.home-seo--embedded {
		display: grid;
		gap: 1.35rem;
		width: 100%;
		min-width: 0;
		padding-block: 0;
	}

	.home-seo__head {
		margin-bottom: 1.35rem;
		padding-bottom: 1.2rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home-seo__eyebrow {
		margin: 0 0 0.4rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.home-seo__head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.05rem, 1.8vw, 1.2rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.25;
		color: var(--ink);
	}

	.home-seo__lede {
		margin: 0.45rem 0 0;
		max-width: 32rem;
		font-size: 0.9rem;
		color: var(--ink-muted);
	}

	.home-seo__cats {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.65rem;
		align-items: stretch;
	}

	.home-seo__cat {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-panel);
		overflow: hidden;
		transition: border-color 0.2s ease;
	}

	.home-seo__cat:hover {
		border-color: color-mix(in srgb, var(--magenta) 35%, var(--line));
	}

	.home-seo__cat-head {
		padding: 0.85rem 0.95rem 0.65rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home-seo__cat-head h3 {
		margin: 0;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--ink);
	}

	.home-seo__cat-head p {
		margin: 0.25rem 0 0;
		font-size: 0.75rem;
		color: var(--ink-faint);
	}

	.home-seo__cat ul {
		margin: 0;
		padding: 0.35rem 0;
		list-style: none;
		flex: 1;
	}

	.home-seo__cat li a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.55rem 0.95rem;
		color: var(--ink-muted);
		font-size: 0.8125rem;
		font-weight: 600;
		text-decoration: none;
		transition: color 0.15s ease, background 0.15s ease;
	}

	.home-seo__cat li a:hover {
		color: var(--magenta-soft);
		background: color-mix(in srgb, var(--magenta) 6%, transparent);
	}

	.home-seo__cat-arrow {
		display: block;
		width: 0.35rem;
		height: 0.35rem;
		border-top: 1.5px solid currentColor;
		border-right: 1.5px solid currentColor;
		transform: rotate(45deg);
		opacity: 0.5;
		flex-shrink: 0;
	}

	.home-seo__faq {
		margin-top: 2rem;
		padding-top: 2rem;
		border-top: 1px solid var(--line-soft);
	}

	.home-seo__faq-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem 1.5rem;
		margin-bottom: 1rem;
	}

	.home-seo__faq-lede {
		margin: 0.35rem 0 0;
		max-width: 32rem;
		font-size: 0.9rem;
		color: var(--ink-muted);
	}

	.home-seo__faq-link {
		display: inline-flex;
		align-items: center;
		min-height: var(--touch-min, 2.75rem);
		padding: 0.45rem 0.85rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-pill);
		background: var(--bg-elevated);
		color: var(--ink-muted);
		font-size: 0.8125rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			color 0.15s ease,
			border-color 0.15s ease;
	}

	.home-seo__faq-link:hover {
		color: var(--magenta-soft);
		border-color: color-mix(in srgb, var(--magenta) 35%, var(--line));
	}

	.home-seo__faq-list {
		display: grid;
		gap: 0.45rem;
	}

	.home-seo__item {
		border: 1px solid var(--line);
		border-radius: var(--radius-md);
		background: var(--bg-panel);
		overflow: hidden;
	}

	.home-seo__item summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.85rem 1rem;
		cursor: pointer;
		font-weight: 600;
		color: var(--ink);
		list-style: none;
	}

	.home-seo__item summary::-webkit-details-marker {
		display: none;
	}

	.home-seo__chev {
		display: block;
		width: 0.45rem;
		height: 0.45rem;
		border-right: 1.5px solid var(--ink-muted);
		border-bottom: 1.5px solid var(--ink-muted);
		transform: rotate(45deg);
		transition: transform 0.2s ease;
		flex-shrink: 0;
	}

	.home-seo__item[open] .home-seo__chev {
		transform: rotate(-135deg);
	}

	.home-seo__item-body {
		padding: 0 1rem 1rem;
		color: var(--ink-muted);
		font-size: 0.9rem;
		line-height: 1.55;
	}

	.home-seo__item-body p {
		margin: 0 0 0.65rem;
	}

	.home-seo__item-link {
		color: var(--magenta-soft);
		font-weight: 600;
		font-size: 0.8125rem;
		text-decoration: none;
	}

	.home-seo__item-link:hover {
		color: var(--ink);
	}

	@media (max-width: 900px) {
		.home-seo__cats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 520px) {
		.home-seo__cats {
			grid-template-columns: 1fr;
		}
	}
</style>
