---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import SiteFooter from './SiteFooter.astro';
import BlogPostCard from './BlogPostCard.astro';
import BlogQuickLinks from './BlogQuickLinks.astro';
import { blogUi, type LocaleCode, defaultLocale } from '../data/i18n/locales';
import {
	absoluteBlogUrl,
	getAllPostsForLocale,
	getBlogBasePath,
	getFeaturedPosts,
	getBlogIndexHreflangAlternates,
} from '../data/blog/helpers';
import { blogLabel, siteConfig } from '../data/site';
import { brandSeo, seoPageTitle } from '../data/site-core';
import { seoDescription } from '../data/brand';
import { getLocalizedPath } from '../data/i18n/routing';
import { blogIndexTopicLinks } from '../data/internal-links';
import RelatedPages from './RelatedPages.astro';
import { getT } from '../i18n/server';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const ui = blogUi[locale];
const t = getT(locale);
const posts = getAllPostsForLocale(locale);
const featured = getFeaturedPosts(locale, 2);
const featuredIds = new Set(featured.map((p) => p.id));
const rest = posts.filter((p) => !featuredIds.has(p.id));

const categories = [...new Set(posts.map((p) => p.category))];
const postsByCategory = categories.map((category) => ({
	category,
	slug: category.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
	items: rest.filter((p) => p.category === category),
}));

const canonicalPath = getBlogBasePath(locale);
const canonicalURL = absoluteBlogUrl(locale);
const hreflangAlternates = getBlogIndexHreflangAlternates(locale);
const homeHref = getLocalizedPath('home', locale);

const pageTitle = locale === defaultLocale ? seoPageTitle(brandSeo.blogTitle) : ui.blogTitle;
const pageDescription =
	locale === defaultLocale ? seoDescription(brandSeo.blogDescription) : ui.blogDescription;

const articleListSchema = {
	'@type': 'CollectionPage',
	'@id': `${canonicalURL}#collection`,
	name: ui.blogH1,
	description: pageDescription,
	url: canonicalURL,
	inLanguage: locale,
	isPartOf: { '@id': `${siteConfig.url}/#website` },
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: posts.map((post, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			url: absoluteBlogUrl(locale, post.translation.slug),
			name: post.translation.title,
		})),
	},
};
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalPath={canonicalPath}
	hreflangAlternates={hreflangAlternates}
	keywords={['lol cheats guide', 'lol esp setup', 'lol aimbot settings', 'vanguard updates']}
	locale={locale}
	ogImage={siteConfig.defaultOgImage}
	ogImageAlt={ui.blogH1}
	breadcrumbs={[{ label: ui.home, href: homeHref }, { label: ui.blogH1 }]}
	extraGraph={[articleListSchema]}
>
	<Navbar locale={locale} />
	<main class="blog">
		<div class="shell blog__inner">
			<header class="blog__hero">
				<p class="blog__eyebrow" data-edit="blogLabel">{blogLabel}</p>
				<h1>{ui.blogH1}</h1>
				<p class="blog__intro">{ui.blogIntro}</p>
				<BlogQuickLinks locale={locale} />
			</header>

			{
				featured.length > 0 && (
					<section class="blog__featured" aria-label={t('common.featured')}>
						<h2 class="blog__section-title">{t('common.featured')}</h2>
						<div class="blog__featured-grid">
							{featured.map((post, index) => (
								<BlogPostCard
									post={post}
									readMore={ui.readMore}
									updatedLabel={ui.updated}
									variant="feature"
									priority={index === 0}
								/>
							))}
						</div>
					</section>
				)
			}

			<nav class="blog__cats" aria-label="Guide categories">
				{
					categories.map((cat) => {
						const slug = cat.toLowerCase().replace(/[^a-z0-9]+/g, '-');
						return (
							<a href={`#cat-${slug}`} class="blog__cat-pill">
								{cat}
							</a>
						);
					})
				}
			</nav>

			{
				postsByCategory.map(({ category, slug, items }) =>
					items.length > 0 ? (
						<section class="blog__group" id={`cat-${slug}`} aria-labelledby={`blog-cat-${slug}`}>
							<h2 class="blog__section-title" id={`blog-cat-${slug}`}>
								{category}
							</h2>
							<div class="blog__grid">
								{items.map((post) => (
									<BlogPostCard post={post} readMore={ui.readMore} updatedLabel={ui.updated} />
								))}
							</div>
						</section>
					) : null,
				)
			}

			<RelatedPages locale={locale} variant="topics" links={blogIndexTopicLinks} class="blog__topics" />
		</div>
	</main>
	<SiteFooter locale={locale} />
</Layout>

<style>
	.blog {
		padding: 2.5rem 0 4rem;
	}

	.blog__inner {
		display: grid;
		gap: 2rem;
	}

	.blog__hero {
		display: grid;
		gap: 0.85rem;
		padding: clamp(1.25rem, 3vw, 1.75rem);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg, 1rem);
		background:
			radial-gradient(ellipse 75% 60% at 0% 0%, color-mix(in srgb, var(--magenta) 12%, transparent), transparent 55%),
			var(--bg-panel);
	}

	.blog__eyebrow {
		margin: 0;
		color: var(--magenta-soft);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-size: 0.75rem;
	}

	.blog__hero h1 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 3rem);
		line-height: 1.05;
		letter-spacing: -0.03em;
	}

	.blog__intro {
		margin: 0;
		max-width: 40rem;
		color: var(--ink-muted);
		font-size: 1.02rem;
		line-height: 1.6;
	}

	.blog__section-title {
		margin: 0 0 1rem;
		font-size: 1.05rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.blog__featured-grid {
		display: grid;
		gap: 1rem;
	}

	.blog__cats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.blog__cat-pill {
		display: inline-flex;
		padding: 0.45rem 0.85rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--bg-elevated);
		color: var(--ink-muted);
		font-size: 0.78rem;
		font-weight: 600;
		text-decoration: none;
	}

	.blog__cat-pill:hover {
		color: var(--magenta-soft);
		border-color: color-mix(in srgb, var(--magenta) 35%, var(--line));
	}

	.blog__group {
		display: grid;
		gap: 0.5rem;
		scroll-margin-top: calc(var(--header-h, 4rem) + 1rem);
	}

	.blog__grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
		gap: 1rem;
	}

	.blog__topics {
		margin-top: 0.5rem;
	}

	@media (max-width: 760px) {
		.blog__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
