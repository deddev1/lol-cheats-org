---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import HomeReviews from '../components/HomeReviews.astro';
import HomeSeo from '../components/HomeSeo.astro';
import HomeAbout from '../components/HomeAbout.astro';
import ExternalResources from '../components/ExternalResources.astro';
import { externalUrls } from '../data/external-resources';
import SiteFooter from '../components/SiteFooter.astro';
import { getLocaleContent, getPageContent } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import type { LocaleCode } from '../data/i18n/locales';
import { homeFaqs, homeSeo, productInfo, seoKeywords, siteConfig, customerReviewStats } from '../data/site';
import { heroPreloadSrc, heroSizes, heroSrcSet } from '../lib/responsive-images';
import { defaultCrawlImageSrc } from '../data/page-images';
import { getNavPaths } from '../data/i18n/localized-nav-paths';
import { resolveImageAlt } from '../lib/image-alt';
import { getT } from '../i18n/server';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const navPaths = getNavPaths(locale);
const t = getT(locale);
const { ui } = getLocaleContent(locale);
const home = getPageContent(locale, 'home');
const enHome = homeSeo();

const title = locale === 'en' ? enHome.title : home.title;
const description = locale === 'en' ? enHome.description : home.description;
const canonicalPath = getLocalizedPath('home', locale);
const canonicalURL = new URL(canonicalPath, siteConfig.url).href;
/** Canonical product entity — always the English money URL, even on locale home pages. */
const canonicalProductUrl = new URL('/', siteConfig.url).href;
const heroImage = new URL(siteConfig.defaultOgImage || defaultCrawlImageSrc, siteConfig.url).href;
const priceValidUntil = '2027-12-31';

const aggregateRating = {
	'@type': 'AggregateRating',
	ratingValue: customerReviewStats.averageRating.toFixed(1),
	reviewCount: String(customerReviewStats.totalCount),
	bestRating: '5',
	worstRating: '1',
};

/** One commerce type only — Product. Reviews live on /reviews/. */
const extraGraph: Record<string, unknown>[] = [
	{
		'@type': 'Product',
		'@id': `${canonicalProductUrl}#product`,
		name: productInfo.name,
		description: productInfo.summary,
		image: heroImage,
		brand: { '@type': 'Brand', name: productInfo.brand },
		url: canonicalProductUrl,
		aggregateRating,
		offers: {
			'@type': 'AggregateOffer',
			lowPrice: Math.min(...productInfo.plans.map((p) => p.price)).toFixed(2),
			highPrice: Math.max(...productInfo.plans.map((p) => p.price)).toFixed(2),
			priceCurrency: productInfo.currency,
			offerCount: productInfo.plans.length,
			availability: 'https://schema.org/InStock',
			url: siteConfig.checkoutUrl,
			offers: productInfo.plans.map((plan) => ({
				'@type': 'Offer',
				name: `${productInfo.name} ${plan.label}`,
				price: plan.price.toFixed(2),
				priceCurrency: productInfo.currency,
				priceValidUntil,
				availability: 'https://schema.org/InStock',
				url: siteConfig.checkoutUrl,
				seller: { '@id': `${siteConfig.url}/#organization` },
			})),
		},
	},
	{
		'@type': 'FAQPage',
		'@id': `${canonicalURL}#faq`,
		mainEntity: homeFaqs.map((item) => ({
			'@type': 'Question',
			name: item.question,
			url: `${siteConfig.url}/faq/${item.slug}/`,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.answer,
			},
		})),
	},
];
---

<Layout
	title={title}
	description={description}
	keywords={[...seoKeywords]}
	canonicalPath={canonicalPath}
	ogImage={siteConfig.defaultOgImage}
	ogImageAlt={resolveImageAlt(home.imageAlt)}
	locale={locale}
	pageId="home"
	breadcrumbs={[{ label: ui.nav.home }]}
	extraGraph={extraGraph}
	lcpImage={heroPreloadSrc}
	lcpImageSrcSet={heroSrcSet}
	lcpImageSizes={heroSizes}
>
	<Navbar locale={locale} pageId="home" />
	<main class="home">
		<Hero locale={locale} />
		<HomeReviews locale={locale} />
		<section class="home-guides shell" aria-labelledby="home-guides-title">
			<div class="home-guides__panel">
				<header class="home-guides__head">
					<p class="home-guides__eyebrow">{t('homeSeo.eyebrow')}</p>
					<h2 id="home-guides-title">{t('homeSeo.title')}</h2>
					<p class="home-guides__lede">{t('homeSeo.lede')}</p>
				</header>
				<HomeAbout locale={locale} paths={navPaths} />
				<HomeSeo locale={locale} navPaths={navPaths} embedded />
				<ExternalResources locale={locale} omitHrefs={[externalUrls.wiki]} class="home-guides__external" />
			</div>
		</section>
	</main>
	<SiteFooter locale={locale} />
</Layout>

<style>
	.home {
		width: 100%;
		overflow-x: clip;
	}

	.home-guides {
		padding-block: clamp(2.5rem, 5vw, 3.5rem);
		border-top: 1px solid var(--line);
		background: var(--bg-section);
		content-visibility: auto;
		contain-intrinsic-size: 1px 900px;
	}

	.home-guides__head {
		margin: 0;
		padding-bottom: 1.15rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home-guides__eyebrow {
		margin: 0 0 0.35rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.home-guides__head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.15rem, 2.2vw, 1.45rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.home-guides__lede {
		margin: 0.45rem 0 0;
		max-width: 40rem;
		font-size: 0.9rem;
		color: var(--ink-muted);
		line-height: 1.55;
	}

	.home-guides__panel {
		display: grid;
		gap: 1.35rem;
		width: 100%;
		min-width: 0;
		padding: clamp(1.15rem, 2.5vw, 1.65rem);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg, 1rem);
		background:
			radial-gradient(ellipse 80% 60% at 0% 0%, color-mix(in srgb, var(--magenta) 8%, transparent), transparent 55%),
			var(--bg-panel);
	}
</style>

<style is:global>
	.home-guides__intro {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(200px, 300px);
		gap: clamp(1rem, 2.5vw, 1.5rem);
		align-items: start;
		width: 100%;
		min-width: 0;
		padding-bottom: 1.15rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home-guides__copy {
		min-width: 0;
	}

	.home-guides__kicker {
		margin: 0 0 0.65rem;
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.home-guides__copy p {
		margin: 0 0 0.75rem;
		color: var(--ink-muted);
		line-height: 1.65;
		font-size: 0.9375rem;
	}

	.home-guides__copy p:last-child {
		margin-bottom: 0;
	}

	.home-guides__copy a {
		color: var(--magenta-soft);
		font-weight: 600;
		text-decoration: none;
	}

	.home-guides__copy a:hover {
		color: var(--ink);
	}

	.home-seo--embedded {
		display: grid;
		gap: 1.35rem;
		width: 100%;
		min-width: 0;
		padding-block: 0;
	}

	.home-seo--embedded .home-seo__cats {
		width: 100%;
		min-width: 0;
	}

	.home-seo--embedded .home-seo__faq {
		margin: 0;
		padding-top: 1.15rem;
		border-top: 1px solid var(--line-soft);
	}

	.home-guides__external {
		margin-top: 0 !important;
		padding-top: 1.15rem !important;
		border: 0 !important;
		border-radius: 0 !important;
		background: transparent !important;
		border-top: 1px solid var(--line-soft) !important;
	}

	@media (max-width: 860px) {
		.home-guides__intro {
			grid-template-columns: 1fr;
		}
	}
</style>
