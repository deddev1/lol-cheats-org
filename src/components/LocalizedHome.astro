---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import HomeReviews from '../components/HomeReviews.astro';
import HomeSeo from '../components/HomeSeo.astro';
import HomeAboutApp from '../components/react/HomeAbout';
import ExternalResources from '../components/ExternalResources.astro';
import { externalUrls } from '../data/external-resources';
import SiteFooter from '../components/SiteFooter.astro';
import { getLocaleContent, getPageContent } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import type { LocaleCode } from '../data/i18n/locales';
import { homeFaqs, homeSeo, productInfo, siteConfig, customerReviewStats } from '../data/site';
import { heroPreloadSrc, heroSizes, heroSrcSet } from '../lib/responsive-images';
import { defaultCrawlImageSrc } from '../data/page-images';
import { getNavPaths } from '../data/i18n/localized-nav-paths';
import { resolveImageAlt } from '../lib/image-alt';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const navPaths = getNavPaths(locale);
const { ui } = getLocaleContent(locale);
const home = getPageContent(locale, 'home');
const enHome = homeSeo();

const title = locale === 'en' ? enHome.title : home.title;
const description = locale === 'en' ? enHome.description : home.description;
const canonicalPath = getLocalizedPath('home', locale);
const canonicalURL = new URL(canonicalPath, siteConfig.url).href;
/** Canonical product entity — always the English money URL, even on locale home pages. */
const canonicalProductUrl = new URL('/', siteConfig.url).href;
const heroImage = new URL(siteConfig.defaultOgImage || defaultCrawlImageSrc, siteConfig.url).href;
const priceValidUntil = '2027-12-31';

const aggregateRating = {
	'@type': 'AggregateRating',
	ratingValue: customerReviewStats.averageRating.toFixed(1),
	reviewCount: String(customerReviewStats.totalCount),
	bestRating: '5',
	worstRating: '1',
};

/** One commerce type only — Product. Reviews live on /reviews/. */
const extraGraph: Record<string, unknown>[] = [
	{
		'@type': 'Product',
		'@id': `${canonicalProductUrl}#product`,
		name: productInfo.name,
		description: productInfo.summary,
		image: heroImage,
		brand: { '@type': 'Brand', name: productInfo.brand },
		url: canonicalProductUrl,
		aggregateRating,
		offers: {
			'@type': 'AggregateOffer',
			lowPrice: Math.min(...productInfo.plans.map((p) => p.price)).toFixed(2),
			highPrice: Math.max(...productInfo.plans.map((p) => p.price)).toFixed(2),
			priceCurrency: productInfo.currency,
			offerCount: productInfo.plans.length,
			availability: 'https://schema.org/InStock',
			url: siteConfig.checkoutUrl,
			offers: productInfo.plans.map((plan) => ({
				'@type': 'Offer',
				name: `${productInfo.name} ${plan.label}`,
				price: plan.price.toFixed(2),
				priceCurrency: productInfo.currency,
				priceValidUntil,
				availability: 'https://schema.org/InStock',
				url: siteConfig.checkoutUrl,
				seller: { '@id': `${siteConfig.url}/#organization` },
			})),
		},
	},
	{
		'@type': 'FAQPage',
		'@id': `${canonicalURL}#faq`,
		mainEntity: homeFaqs.map((item) => ({
			'@type': 'Question',
			name: item.question,
			url: `${siteConfig.url}/faq/${item.slug}/`,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.answer,
			},
		})),
	},
];
---

<Layout
	title={title}
	description={description}
	canonicalPath={canonicalPath}
	ogImage={siteConfig.defaultOgImage}
	ogImageAlt={resolveImageAlt(home.imageAlt)}
	locale={locale}
	pageId="home"
	breadcrumbs={[{ label: ui.nav.home }]}
	extraGraph={extraGraph}
	lcpImage={heroPreloadSrc}
	lcpImageSrcSet={heroSrcSet}
	lcpImageSizes={heroSizes}
>
	<Navbar locale={locale} pageId="home" />
	<main class="home">
		<Hero locale={locale} />
		<HomeReviews locale={locale} />
		<div class="home__seo">
			<HomeAboutApp client:visible locale={locale} paths={navPaths} />
			<HomeSeo locale={locale} navPaths={navPaths} />
			<div class="shell">
				<ExternalResources locale={locale} omitHrefs={[externalUrls.wiki]} />
			</div>
		</div>
		<SiteFooter locale={locale} />
	</main>
</Layout>

<style>
	.home {
		width: 100%;
		overflow-x: clip;
	}

	.home__seo {
		border-top: 1px solid var(--line);
		background: var(--bg-section);
		content-visibility: auto;
		contain-intrinsic-size: 1px 900px;
	}

	.home__prose {
		padding-block: var(--section-space);
		color: var(--ink-muted);
		line-height: 1.65;
		font-size: 0.9375rem;
	}

	.home__prose--en {
		padding-block: clamp(2rem, 4vw, 2.75rem) 0.5rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home-about-split {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(220px, 380px);
		gap: clamp(1.25rem, 3vw, 2.5rem);
		align-items: center;
	}

	.home__prose-callout {
		max-width: none;
		padding-left: 1.1rem;
		border-left: 3px solid var(--magenta);
	}

	.home__prose-kicker {
		margin: 0 0 0.7rem;
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.home__prose-callout p {
		margin: 0 0 0.75rem;
	}

	.home__prose-callout p:last-child {
		margin-bottom: 0;
	}

	.home__prose--en a {
		color: var(--magenta-soft);
		font-weight: 600;
		text-decoration: none;
	}

	.home__prose--en a:hover {
		color: var(--ink);
	}

	.home__prose h1,
	.home__prose h2 {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-size: 1.5rem;
		letter-spacing: -0.03em;
		color: var(--ink);
	}

	.home__prose h3 {
		margin: 1.25rem 0 0.5rem;
		font-size: 1rem;
		color: var(--ink);
	}

	@media (max-width: 860px) {
		.home-about-split {
			grid-template-columns: 1fr;
		}
	}
</style>

<style is:global>
	/* HomeAbout is React-rendered — scoped Astro styles do not reach it. */
	.home__prose--en {
		padding-block: clamp(2rem, 4vw, 2.75rem) 0.5rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home-about-split {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(220px, 380px);
		gap: clamp(1.25rem, 3vw, 2.5rem);
		align-items: center;
	}

	.home__prose-callout {
		max-width: none;
		padding-left: 1.1rem;
		border-left: 3px solid var(--magenta);
	}

	.home__prose-kicker {
		margin: 0 0 0.7rem;
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.home__prose-callout p {
		margin: 0 0 0.75rem;
		color: var(--ink-muted);
		line-height: 1.65;
		font-size: 0.9375rem;
	}

	.home__prose-callout p:last-child {
		margin-bottom: 0;
	}

	.home__prose--en a {
		color: var(--magenta-soft);
		font-weight: 600;
		text-decoration: none;
	}

	.home__prose--en a:hover {
		color: var(--ink);
	}

	.lazy-video {
		width: 100%;
		max-width: 380px;
		justify-self: end;
	}

	.lazy-video__trigger {
		position: relative;
		display: block;
		width: 100%;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: var(--radius-md, 0.75rem);
		overflow: hidden;
		background: var(--bg-panel);
		cursor: pointer;
		line-height: 0;
		transition:
			border-color 0.15s ease,
			transform 0.15s ease;
	}

	.lazy-video__trigger:hover {
		border-color: color-mix(in srgb, var(--magenta) 40%, var(--line));
		transform: translateY(-2px);
	}

	.lazy-video__trigger img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 11;
		object-fit: cover;
	}

	.lazy-video__play {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		background: color-mix(in srgb, #070d14 35%, transparent);
		transition: background 0.15s ease;
	}

	.lazy-video__trigger:hover .lazy-video__play {
		background: color-mix(in srgb, #070d14 25%, transparent);
	}

	.lazy-video__play svg {
		width: 3.25rem;
		height: 3.25rem;
		padding: 0.85rem;
		border-radius: 50%;
		background: color-mix(in srgb, var(--magenta) 92%, #fff);
		color: #070d14;
		box-shadow: 0 8px 28px rgba(0, 0, 0, 0.45);
	}

	.lazy-video__player {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 11;
		object-fit: cover;
		border: 1px solid var(--line);
		border-radius: var(--radius-md, 0.75rem);
		background: #000;
	}

	@media (max-width: 860px) {
		.home-about-split {
			grid-template-columns: 1fr;
		}

		.lazy-video {
			max-width: none;
			justify-self: stretch;
		}
	}
</style>
